# Copy to .env.local for local development. Never commit real keys.
# In Vercel, set these under Project → Settings → Environment Variables
# for both Production and Preview.

# Canonical site URL (apex domain, no trailing slash).
NEXT_PUBLIC_SITE_URL=https://nadeersarid.com

# Resend (https://resend.com) – sends the contact form to Nadeer.
RESEND_API_KEY=
# Inbox that receives form submissions (Nadeer's own address).
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend.
CONTACT_FROM_EMAIL="אתר נדיר שריד <form@nadeersarid.com>"

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile).
# For local development you can use Cloudflare's public test keys, which always pass:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
